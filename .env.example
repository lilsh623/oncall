APP_ENV=production
DATABASE_URL=postgresql+asyncpg://oncall:oncall@127.0.0.1:15432/oncall
REDIS_URL=redis://127.0.0.1:16379/0
JWT_SECRET=replace-with-a-secure-jwt-secret
BAILIAN_API_KEY=replace-with-your-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=qwen-plus
AGENT_LOOP_MAX_TURNS=8
AGENT_SPECIALIST_MAX_TURNS=4
AGENT_MAX_TOOL_CALLS=16
OPENAI_AGENTS_TRACING_ENABLED=false
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSION=1024
MILVUS_URI=http://127.0.0.1:19530
MILVUS_KNOWLEDGE_COLLECTION=oncall_operational_knowledge
CONVERSATION_ROUTER_LIVE=true
MEM0_ENABLED=true
MEM0_COLLECTION=oncall_conversation_memory
MEM0_TELEMETRY=false
RECOVERY_MCP_URL=http://127.0.0.1:8080/mcp
RECOVERY_MCP_SECRET=replace-with-a-secure-mcp-secret
RECOVERY_APPROVAL_SECRET=replace-with-an-independent-approval-secret
RECOVERY_VERIFICATION_WAIT_SECONDS=45
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Optional private or internal Tencent Cloud API endpoint.
TENCENTCLOUD_API_BASE_HOST=
CLS_MCP_URL=http://127.0.0.1:3000/mcp
# Optional inbound token if the CLS MCP server is fronted by an authenticated gateway.
CLS_MCP_AUTH_TOKEN=
MCP_TIMEOUT_SECONDS=8
MCP_MAX_RESULT_BYTES=32768
