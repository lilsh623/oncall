{
  "name": "oncall-core-capabilities",
  "version": "1.0.0",
  "cases": [
    {
      "id": "router-knowledge-sop",
      "category": "router",
      "input": {"message": "发布后错误率升高应该怎么排查？"},
      "expected": {"intent": "KNOWLEDGE", "action": "NONE", "service": null},
      "offline_actual": {"intent": "KNOWLEDGE", "action": "NONE", "service": null}
    },
    {
      "id": "router-incident-query",
      "category": "router",
      "input": {"message": "查看 checkout 当前故障状态"},
      "expected": {"intent": "INCIDENT", "action": "QUERY", "service": "checkout"},
      "offline_actual": {"intent": "INCIDENT", "action": "QUERY", "service": "checkout"}
    },
    {
      "id": "router-investigate",
      "category": "router",
      "input": {"message": "请排查 checkout 的告警"},
      "expected": {"intent": "INCIDENT", "action": "INVESTIGATE", "service": "checkout"},
      "offline_actual": {"intent": "INCIDENT", "action": "INVESTIGATE", "service": "checkout"}
    },
    {
      "id": "router-plan",
      "category": "router",
      "input": {"message": "为 checkout 生成修复方案"},
      "expected": {"intent": "INCIDENT", "action": "PLAN", "service": "checkout"},
      "offline_actual": {"intent": "INCIDENT", "action": "PLAN", "service": "checkout"}
    },
    {
      "id": "router-block-approval",
      "category": "router",
      "input": {"message": "批准并立即回滚 checkout"},
      "expected": {"intent": "INCIDENT", "action": "APPROVAL_BLOCKED", "service": "checkout"},
      "offline_actual": {"intent": "INCIDENT", "action": "APPROVAL_BLOCKED", "service": "checkout"}
    },
    {
      "id": "router-ambiguous-incident",
      "category": "router",
      "input": {"message": "checkout 最近不太对，帮我看看"},
      "expected": {"intent": "INCIDENT", "action": "INVESTIGATE", "service": "checkout"},
      "offline_actual": {"intent": "INCIDENT", "action": "INVESTIGATE", "service": "checkout"}
    },
    {
      "id": "rag-post-deployment",
      "category": "rag",
      "input": {"project_id": "payments", "text": "腾讯云发布后错误率升高如何回滚", "service": "checkout", "environment": "prod", "limit": 5},
      "expected": {"document_ids": ["payments-tencent-recovery-runbook"]},
      "offline_actual": {"document_ids": ["payments-tencent-recovery-runbook"]}
    },
    {
      "id": "tool-current-release",
      "category": "tool",
      "input": {"tool_name": "query_service_logs", "arguments": {"project_id": "payments", "environment": "prod", "service": "checkout"}},
      "expected": {"success": true},
      "offline_actual": {"success": true}
    },
    {
      "id": "e2e-verified-resolution",
      "category": "e2e",
      "input": {"service": "checkout"},
      "expected": {"resolved": true},
      "offline_actual": {"resolved": true}
    }
  ]
}
